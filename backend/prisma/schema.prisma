model Deal {
  id                String   @id @default(uuid())
  leadId            String   @unique
  lead              Lead     @relation(fields: [leadId], references: [id])
  affiliateId       String
  affiliate         Affiliate @relation(fields: [affiliateId], references: [id])
  
  // Dados preenchidos no Handover pelo consultor
  selectedPackage   String
  finalValue        String
  offerDetails      String   @db.Text
  
  // Status de Pós-Venda e Asaas
  status            String   @default("WAITING_FINANCIAL_VALIDATION") // Admin avalia aqui
  asaasPaymentId    String?
  downPaymentPaid   Boolean  @default(false)
  createdAt         DateTime @default(now())
}