datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  AFFILIATE
}

enum AffiliateStatus {
  PENDING_APPROVAL
  APPROVED
  BLOCKED
}

enum LeadStatus {
  LEAD_REGISTERED
  POOL                      
  COMMERCIAL_CONTACT
  WAITING_INTERNAL_REVIEW
  PROPOSAL_SENT
  DEAL_CLOSED
  DISCARDED
}

enum ContactOutcome {
  NO_ANSWER
  INVALID_NUMBER
  CALL_BACK
  CONTACTED
  MEETING_SCHEDULED
  NOT_INTERESTED
  AWAITING_CLOSING
}

enum CommissionStatus {
  WAITING_INVOICE
  INVOICE_SUBMITTED
  APPROVED
  PAID
  REJECTED
}

model CommissionTier {
  id             Int         @id @default(autoincrement())
  name           String
  minDeals       Int
  maxDeals       Int?
  commissionRate Float
  affiliates     Affiliate[]
}

model Affiliate {
  id             String          @id @default(uuid())
  role           Role            @default(AFFILIATE)
  cnpj           String          @unique
  companyName    String
  tradeName      String?
  responsible    String
  email          String          @unique
  passwordHash   String
  phone          String
  status         AffiliateStatus @default(PENDING_APPROVAL)
  pixKey         String?
  contractSigned Boolean         @default(false)
  createdAt      DateTime        @default(now())

  tierId         Int?
  tier           CommissionTier? @relation(fields: [tierId], references: [id])
  
  leads          Lead[]
  deals          Deal[]
  commissions    Commission[]
}

model Lead {
  id              String       @id @default(uuid())
  companyName     String
  tradeName       String?
  cnpj            String?      @unique
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  servicePlan     String?
  status          LeadStatus   @default(LEAD_REGISTERED)

  claimedAt       DateTime?                    // antes: @default(now())
  availableAt     DateTime     @default(now()) // base da carência futura

  city            String?
  state           String?
  cnaeCode        String?
  cnaeDescription String?
  source          String?                      // BASE_CENTRAL | CONSULTOR

  importBatchId   String?
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id])

  affiliateId     String?                      // antes: obrigatório
  affiliate       Affiliate?   @relation(fields: [affiliateId], references: [id])
  deal            Deal?

  @@index([status, state, city])
  @@index([status, cnaeCode])

  lastOutcome    ContactOutcome?
  lastActivityAt DateTime?
  nextActionAt   DateTime?
  activities     LeadActivity[]
}

model LeadActivity {
  id           String         @id @default(uuid())
  leadId       String
  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  affiliateId  String
  outcome      ContactOutcome
  reason       String?
  note         String?        @db.Text
  nextActionAt DateTime?
  createdAt    DateTime       @default(now())

  @@index([leadId, createdAt])
  @@index([affiliateId, createdAt])
}

model ImportBatch {
  id         String   @id @default(uuid())
  filename   String
  uploadedBy String
  total      Int
  inserted   Int
  duplicates Int
  invalid    Int
  createdAt  DateTime @default(now())
  leads      Lead[]
}

model Deal {
  id              String   @id @default(uuid())
  leadId          String   @unique
  lead            Lead     @relation(fields: [leadId], references: [id])
  
  affiliateId     String
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id])
  
  selectedPackage String
  finalValue      String
  offerDetails    String   @db.Text
  
  status          String   @default("WAITING_FINANCIAL_VALIDATION")
  asaasPaymentId  String?
  paymentUrl      String?
  totalCents      Int?
  closedAt        DateTime @default(now())

  commission      Commission?

  paidAt          DateTime?
}

model Commission {
  id              String           @id @default(uuid())
  appliedRate     Float
  amount          Float
  status          CommissionStatus @default(WAITING_INVOICE)
  invoiceUrl      String?
  invoiceUploaded DateTime?
  paidAt          DateTime?

  dealId          String           @unique
  deal            Deal             @relation(fields: [dealId], references: [id])
  
  affiliateId     String
  affiliate       Affiliate        @relation(fields: [affiliateId], references: [id])
}

model WebhookEvent {
  id          String    @id
  event       String
  paymentId   String?
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([paymentId])
}